# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel: Settings → Environment Variables → add the same keys
# for Production, Preview, and Development, then Redeploy.

# MongoDB connection string (use Atlas for production — not localhost)
MONGODB_URI=mongodb://127.0.0.1:27017/track_dashboard

# JWT signing secret — min 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# OPTIONAL — deployment-wide floor for the first day TrackDash counts.
#
# You usually do NOT need this. Each account already starts tracking on the day
# it was created, and an admin can override that per user in Users → "Tracking
# from". Set this only to hard-stop the whole deployment from counting anything
# before a given go-live date.
#
# Leave it unset (or delete the line) to let per-user dates govern on their own.
# NEXT_PUBLIC_TRACKING_START_DATE=2026-08-17
