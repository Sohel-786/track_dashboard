# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel: Settings → Environment Variables → add the same keys
# for Production, Preview, and Development, then Redeploy.

# MongoDB connection string (use Atlas for production — not localhost)
MONGODB_URI=mongodb://127.0.0.1:27017/track_dashboard

# JWT signing secret — min 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# OPTIONAL — deployment-wide floor for the first day TrackDash counts.
#
# You usually do NOT need this. Each account already starts tracking on the day
# it was created, and an admin can override that per user in Users → "Tracking
# from". Set this only to hard-stop the whole deployment from counting anything
# before a given go-live date.
#
# Leave it unset (or delete the line) to let per-user dates govern on their own.
# NEXT_PUBLIC_TRACKING_START_DATE=2026-08-17

# --- Push notifications (Namaz prayer reminders) ---
# Generate a keypair once:
#   npx web-push generate-vapid-keys
# Then add all three on the host (Vercel -> Settings -> Environment Variables).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ss1036425@gmail.com

# Shared secret for the reminder job at /api/notifications/run.
#
# REMINDERS DO NOT FIRE UNTIL SOMETHING CALLS THAT URL ON A SCHEDULE. Nothing in
# the app watches the clock, and Vercel's Hobby plan will not run a cron more
# than once a day, so an external scheduler drives it -- see "Scheduling the job"
# in the README. Point it at the URL once a minute and send this secret as an
# x-cron-secret header (a ?key=... query string and a Bearer token also work).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-secret

# --- Journey map (OpenStreetMap) ---
# The map needs NO account and NO API key. Tiles come from OpenStreetMap and
# CARTO; masjid search and place names come from Overpass and Nominatim, all of
# which are free and keyless.
#
# OPTIONAL. OSM's usage policy asks that a self-hosted app identify itself so
# its operators can reach you before they resort to rate-limiting. Set this to
# an email address or a URL and it is sent in the User-Agent header. When it is
# unset, VAPID_SUBJECT is used if it is a mailto: address.
# MAP_CONTACT=you@example.com
